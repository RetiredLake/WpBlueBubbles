<Application x:Class="WpBlueBubbles.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" RequestedTheme="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="MessengerBlue">#0E639C</Color>
      <SolidColorBrush x:Key="MessengerBlueBrush" Color="{StaticResource MessengerBlue}" />
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#071117" />
      <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#0B171E" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#AEB8BE" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
